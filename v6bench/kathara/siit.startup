#!/bin/sh

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

mkdir -p /dev/net /var/spool/tayga
[ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200

source /shared/env/test_vars.env
BASE_IPV6="$(dig "${BASE_DOMAIN}" @8.8.8.8 aaaa +short +cd +do |head -1)" # tags 'cd' and 'do' are included to avoid nat64 resolver

cat > /etc/tayga.conf <<CONF
tun-device siit
ipv4-addr 192.168.254.1
ipv6-addr 2001:db8:47::1
prefix 2001:db8:46::/96
map 192.168.0.1  2001:db8:4::c0a8:1
map 192.168.0.10 2001:db8:4::c0a8:a
map 192.168.0.40 2001:db8:4::c0a8:28
map 192.168.0.46 2001:db8:4::c0a8:2e
map 192.168.0.53 2001:db8:4::c0a8:35
map 192.168.0.64 2001:db8:4::c0a8:40
map 192.168.46.1 ${BASE_IPV6}
data-dir /var/spool/tayga
CONF

tayga --mktun -c /etc/tayga.conf
ip link set siit up
ip route add 192.168.46.0/24 dev siit
ip -6 route add 2001:db8:4::/96 dev siit
tayga -c /etc/tayga.conf


# modprobe jool_siit
# jool_siit instance add "siit" --netfilter
# jool_siit -i "siit" eamt add 2001:db8:4::/120 192.168.0.0/24
# jool_siit -i "siit" eamt add "${BASE_IPV6}/128" 192.168.46.1/32
